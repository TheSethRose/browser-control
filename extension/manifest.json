{
  "manifest_version": 3,
  "key": "",
  "name": "Browser Control Companion",
  "version": "2.0.0",
  "minimum_chrome_version": "125",
  "description": "Local-only companion for browser-control: silent isolated-world reads, on-demand tab CDP, and per-tab lending without remote-debugging flags.",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "storage",
    "alarms",
    "webNavigation",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Browser Control Companion",
    "default_icon": {
      "16": "icons/state-off-16.png",
      "32": "icons/state-off-32.png"
    },
    "default_popup": "popup.html"
  }
}
