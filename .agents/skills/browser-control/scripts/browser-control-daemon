#!/usr/bin/env bash
# One shared background process holds the browser connections, so Chrome's "Allow remote
# debugging" prompt appears once per browser, not once per call or per agent session.
# Every command re-uses that process and starts it only if it is not running.
#
#   tabs                              list tabs; * marks the selected one
#   nav <url> [--snap] [--until load] navigate; --snap also lists the controls
#   eval '<js>'                       run JavaScript, print its value ('-' reads stdin)
#   call <op> ['<json>']              any operation, JSON in and out
#   start [browser]                   switch browser by name (chrome, beta, brave); opens it
#                                     if needed. Never pass a port.
#   default [browser]                 show or set the default browser
#   ops | status
#   stop --force                      ONLY when the user asks: drops every approved connection,
#                                     so the user must click Allow again
#
# Read the page:
#   snap [--all] [--find <text>] [--within <ref|css>] [--ax]   controls with refs: - button "Save" [e12]
#   text [--all] [--within <ref|css>] [--max <chars>]          readable content as markdown
#   value <ref|label>                 a control's value (never a secure field)
#   ocr [--find <text>]               text read from a picture of the tab, each with x,y to click:
#                                     for pages that are only a canvas (remote isolation)
#   shot [--ref <ref>] [--marks] [--full] [--png] [--to <path>]  small JPEG; --marks numbers the controls
#   verdict | health                  after a submit: confirmed/rejected/unverified | page health JSON
#
# Act on it (each prints what changed; --quiet leaves that out):
#   click <ref|label>                 checked click: visible, enabled, still, not covered
#   click --xy <x,y>                  click CSS-pixel coordinates; prints what was hit
#   type [--keys] <ref|label> <text>  replace the field's text, read it back
#   type --focused <text>             type into whatever has focus (after click --xy)
#   key <Enter|Tab|Escape|Backspace|ArrowDown|ArrowUp|Space>
#   fill '{"<ref|label>":"<text>",…}' several fields in one call
#   do '[{"type":["Email","a@b.co"]},{"key":"Tab"},{"click":"Next"}]'   several steps in one call;
#                                     stops at the first step that fails ('-' reads stdin)
#
# A <ref> is e12 (from snap), f2:e5 (inside iframe 2), a41 (from snap --ax), or a control's
# visible label in quotes. A label that fits several controls fails and lists them.
# Every page command takes a targetId as its last argument, or --match <text in url or title>.
# Plain-text output; a failure prints {"ok":false,"error":…} and exits 1.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
tmp="${TMPDIR:-/tmp}"
dir="${BROWSER_CONTROL_DAEMON_DIR:-${tmp%/}/browser-control-daemon}"
sock="$dir/sock"; log="$dir/daemon.log"; lock="$dir/starting"

fail() { echo '{"ok":false,"error":{"code":"'"$1"'","message":"'"$2"'"}}'; exit 1; }

# req <METHOD> <path> [body]: print the reply. Status 0 ok, 1 the daemon said no,
# 7 not running (nothing was sent), 9 the connection broke after the request went out.
req() {
  local rc=0
  printf '%s' "${3:-}" | curl -sS --fail-with-body --unix-socket "$sock" -X "$1" \
    --data-binary @- "http://daemon/$2" 2>/dev/null || rc=$?
  case $rc in 0) ;; 22) return 1 ;; 7) return 7 ;; *) return 9 ;; esac
}
up() { req GET status >/dev/null; }

# Start the daemon process if it is not running. Safe to call from several agents at once.
ensure() {
  up && return 0
  command -v bun >/dev/null 2>&1 || { echo "browser-control-daemon: bun is required (https://bun.sh)" >&2; exit 127; }
  mkdir -p "$dir"; chmod 700 "$dir"
  # Drop a lock left by a start that died, then let only one caller start the process.
  find "$lock" -maxdepth 0 -mmin +1 -exec rmdir {} \; 2>/dev/null || true
  if mkdir "$lock" 2>/dev/null; then
    up || { rm -f "$sock"; nohup bun "$here/../runtime/cli.js" --serve "$sock" >"$log" 2>&1 & }
  fi
  for _ in $(seq 100); do up && break; sleep 0.05; done
  rmdir "$lock" 2>/dev/null || true
  up || fail DAEMON_START_FAILED "daemon did not start; see $log. Tell the user; do not work around it."
}

# run <METHOD> <path> [body]: send the request; start the daemon only when nothing answers.
# The daemon connects to the browser by itself on the first call that needs it.
run() {
  local rc=0 out
  out="$(req "$@")" || rc=$?
  if [[ $rc -eq 7 ]]; then ensure; rc=0; out="$(req "$@")" || rc=$?; fi
  [[ -z "$out" ]] || printf '%s\n' "$out"
  case $rc in
    0) return 0 ;;
    9) fail CONNECTION_LOST "the daemon dropped the connection mid-call; the action may have been delivered. Check the page before retrying." ;;
  esac
  if [[ "$out" == *"unknown page helper"* || "$out" == *"unknown daemon route"* ]]; then
    echo "browser-control-daemon: the running daemon is an older build than this script. Ask the user to run: browser-control-daemon stop --force (they will have to click Allow again)." >&2
  fi
  exit 1
}

# JSON string literal without starting another process.
json_str() {
  local s=$1
  if [[ "$s" == *[$'\001'-$'\010'$'\013'$'\014'$'\016'-$'\037']* ]]; then
    printf '%s' "$s" | bun -e 'process.stdout.write(JSON.stringify(require("fs").readFileSync(0, "utf8")))'
    return
  fi
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}
  printf '"%s"' "$s"
}
urlencode() {
  local LC_ALL=C s=$1 out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in [a-zA-Z0-9.~_-]) out+=$c ;; *) out+=$(printf '%%%02X' "'$c") ;; esac
  done
  printf '%s' "$out"
}
body() { if [[ "$1" == "-" ]]; then cat; else printf '%s' "$1"; fi; }
usage() { sed -n '2,41p' "$0" | sed 's/^# \{0,1\}//'; }

cmd="${1:-}"; [[ $# -gt 0 ]] && shift

# Flags may sit anywhere after the command; what is left are the positional arguments.
match=""; quiet=""; all=false; ax=false; keys=false; focused=false; marks=false; full=false; png=false; snap=""
find=""; within=""; max=""; until=""; xy=""; ref_flag=""; to=""
args=()
case "$cmd" in snap | text | ocr | click | type | key | value | shot | nav | eval | fill | do | verdict | health)
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --match) match="${2:?--match needs text from the tab url or title}"; shift 2 ;;
      --quiet) quiet=1; shift ;;
      --all) all=true; shift ;;
      --ax) ax=true; shift ;;
      --keys) keys=true; shift ;;
      --focused) focused=true; shift ;;
      --marks) marks=true; shift ;;
      --full) full=true; shift ;;
      --png) png=true; shift ;;
      --snap) snap=1; shift ;;
      --find) find="${2:?--find needs text}"; shift 2 ;;
      --within) within="${2:?--within needs a ref or CSS selector}"; shift 2 ;;
      --max) max="${2:?--max needs a number}"; shift 2 ;;
      --until) until="${2:?--until needs load or dom}"; shift 2 ;;
      --xy) xy="${2:?--xy needs x,y}"; shift 2 ;;
      --ref) ref_flag="${2:?--ref needs a ref}"; shift 2 ;;
      --to) to="${2:?--to needs a file path}"; shift 2 ;;
      --) shift; while [[ $# -gt 0 ]]; do args+=("$1"); shift; done ;;
      *) args+=("$1"); shift ;;
    esac
  done ;;
*) args=("$@") ;;
esac
arg() { printf '%s' "${args[$1]:-}"; }

# query <targetId>: the ?t=…&m=…&q=1 part of the request path.
query() {
  local q=""
  [[ -z "${1:-}" ]] || q+="&t=$(urlencode "$1")"
  [[ -z "$match" ]] || q+="&m=$(urlencode "$match")"
  [[ -z "$quiet" ]] || q+="&q=1"
  [[ -z "${2:-}" ]] || q+="&$2"
  [[ -z "$q" ]] || printf '?%s' "${q#&}"
}

case "$cmd" in
  start)
    case "$(arg 0)" in
      "") input='{"timeoutMs":60000}' ;;
      *[!0-9]*) b="$(arg 0)"; input='{"browser":"'"${b//[\"\\]/}"'","timeoutMs":60000}' ;;
      *) input='{"port":'"$(arg 0)"',"timeoutMs":60000}' ;;
    esac
    run POST call/connect_browser "$input"
    ;;
  eval)
    [[ ${#args[@]} -ge 1 ]] || fail INPUT_INVALID "usage: browser-control-daemon eval '<js>' [targetId]"
    run POST "eval$(query "$(arg 1)")" "$(body "$(arg 0)")"
    ;;
  nav)
    [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon nav <url> [targetId] [--snap] [--until load]"
    extra=""; [[ -z "$snap" ]] || extra="snap=1"
    [[ "$until" != "load" ]] || extra="${extra:+$extra&}until=load"
    run POST "nav$(query "$(arg 1)" "$extra")" "$(arg 0)"
    ;;
  tabs | ops) run GET "$cmd" ;;
  snap)
    input='{"all":'"$all"',"ax":'"$ax"
    [[ -z "$find" ]] || input+=',"find":'"$(json_str "$find")"
    [[ -z "$within" ]] || input+=',"within":'"$(json_str "$within")"
    run POST "page/snap$(query "$(arg 0)")" "$input}"
    ;;
  text)
    input='{"all":'"$all"
    [[ -z "$within" ]] || input+=',"within":'"$(json_str "$within")"
    [[ -z "$max" ]] || input+=',"max":'"$((max))"
    run POST "page/text$(query "$(arg 0)")" "$input}"
    ;;
  click)
    if [[ -n "$xy" ]]; then
      [[ "$xy" =~ ^[0-9.]+,[0-9.]+$ ]] || fail INPUT_INVALID "--xy takes x,y in CSS pixels, e.g. --xy 120,240"
      run POST "page/click$(query "$(arg 0)")" '{"xy":['"$xy"']}'
    else
      [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon click <ref|label> [targetId]"
      run POST "page/click$(query "$(arg 1)")" '{"ref":'"$(json_str "$(arg 0)")"'}'
    fi
    ;;
  ocr)
    input='{'; [[ -z "$find" ]] || input+='"find":'"$(json_str "$find")"
    run POST "page/ocr$(query "$(arg 0)")" "$input}"
    ;;
  type)
    if [[ "$focused" == true ]]; then
      [[ ${#args[@]} -ge 1 ]] || fail INPUT_INVALID "usage: browser-control-daemon type --focused <text> [targetId]"
      run POST "page/type$(query "$(arg 1)")" '{"focused":true,"text":'"$(json_str "$(arg 0)")"'}'
      exit 0
    fi
    [[ ${#args[@]} -ge 2 ]] || fail INPUT_INVALID "usage: browser-control-daemon type [--keys] <ref|label> <text> [targetId]"
    run POST "page/type$(query "$(arg 2)")" '{"ref":'"$(json_str "$(arg 0)")"',"text":'"$(json_str "$(arg 1)")"',"keys":'"$keys"'}'
    ;;
  key)
    [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon key <name> [targetId]"
    run POST "page/key$(query "$(arg 1)")" '{"key":'"$(json_str "$(arg 0)")"'}'
    ;;
  value)
    [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon value <ref|label> [targetId]"
    run POST "page/value$(query "$(arg 1)")" '{"ref":'"$(json_str "$(arg 0)")"'}'
    ;;
  fill)
    [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon fill '{\\\"<ref|label>\\\":\\\"<text>\\\"}' [targetId]"
    run POST "page/do$(query "$(arg 1)")" '{"fill":'"$(body "$(arg 0)")"'}'
    ;;
  do)
    [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon do '<json array of steps>' [targetId]"
    run POST "page/do$(query "$(arg 1)")" '{"steps":'"$(body "$(arg 0)")"'}'
    ;;
  shot)
    input='{"marks":'"$marks"',"full":'"$full"',"png":'"$png"
    [[ -z "$ref_flag" ]] || input+=',"ref":'"$(json_str "$ref_flag")"
    if [[ -n "$to" ]]; then
      [[ "$to" == /* ]] || to="$PWD/$to"
      input+=',"path":'"$(json_str "$to")"
    fi
    run POST "page/shot$(query "$(arg 0)")" "$input}"
    ;;
  verdict | health) run POST "page/$cmd$(query "$(arg 0)")" '{}' ;;
  call)
    [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon call <operation> ['<json>']"
    run POST "call/$(arg 0)" "$(arg 1)"
    ;;
  default)
    file="${XDG_CONFIG_HOME:-$HOME/.config}/browser-control/default-browser"
    if [[ -n "$(arg 0)" ]]; then mkdir -p "$(dirname "$file")"; printf '%s\n' "$(arg 0)" >"$file"; fi
    cat "$file" 2>/dev/null || echo "(none: the first browser with remote debugging on is used)"
    ;;
  status) req GET status || echo '{"ok":true,"data":{"running":false}}' ;;
  stop)
    [[ "$(arg 0)" == "--force" ]] || fail STOP_REFUSED "stopping drops every approved browser connection and the user must click Allow again. Nothing is fixed by restarting. Only if the user asked: stop --force"
    req POST stop >/dev/null || true; echo '{"ok":true,"data":{"running":false}}'
    ;;
  help | -h | --help) usage ;;
  *) usage; exit 2 ;;
esac
