#!/usr/bin/env bash
# One shared background process holds the browser connections, so Chrome's "Allow remote
# debugging" prompt appears once per browser, not once per call or per agent session.
# Every command re-uses that process and starts it only if it is not running.
#
#   tabs                              list tabs; * marks the selected one
#   nav <url> [--snap] [--until load] navigate; --snap also lists the controls.
#                                     --browser <slug> opens it in that browser
#                                     extension tabs only: --new-window opens it in a new
#                                     window; --keep-open keeps the tab past idle cleanup
#                                     Without a targetId it reuses this agent session's last tab;
#                                     --new-tab opens a new one. BROWSER_CONTROL_SESSION names the session
#   close [targetId]                  close an agent-opened extension tab (active tab if omitted)
#   eval '<js>'                       run JavaScript, print its value ('-' reads stdin)
#   call <op> ['<json>']              any operation, JSON in and out
#   start [browser]                   switch browser by name (chrome, beta, brave, ardia); opens it
#                                     if needed. Never pass a port.
#   default [browser]                 show or set the default browser
#   natural [on|off|status]           show or set global natural browsing (default on; --fast opts out per call).
#                                     Each call resolves it here (env, then file) and sends on/off, so status
#                                     matches what runs
#   ops | status | check-update [--force]
#
# Chrome extension (no remote-debugging prompt):
#   extension setup [extensionDir]    pair this machine and turn the extension backend on;
#                                     extensionDir defaults to the repo's extension/ folder
#   extension status                  relay port, connected browsers, paired yes/no
#   extension browsers                connected browsers: slug, brand, version
#   extension diagnostics             relay and extension state for bug reports (no secrets)
#   extension enable | disable        use the extension for this daemon dir, or CDP only
#   extension pair | revoke           not available yet (Web Store build)
#   stop --force                      ONLY when the user asks: drops every approved connection,
#                                     so remote debugging (cdp) asks the user to Allow again;
#                                     the extension reconnects on its own
#
# Read the page:
#   snap [--all] [--full] [--find <t>] [--within <r|css>] [--ax] [--out <p>]
#   text [--all] [--within <r|css>] [--max <n>] [--scroll] [--filter <t>] [--limit <n>] [--out <p>]
#   form [--within <r|css>] [--out <p>]           list fields, values, validation errors & submits
#   query <css> [--fields k=sel,...] [--limit <n>] [--all] [--out <p>]
#   read-urls <u1> [u2 ...] [--concurrency <n>] [--timeout <ms>] [--out <p>]
#   value <ref|label>                 a control's value (never a secure field)
#   ocr [--find <text>]               text read from a picture of the tab, each with x,y to click
#   shot [--ref <ref>] [--marks] [--full] [--png] [--to <path>]
#   verdict | health | styles <ref|css> [--properties a,b] | issues [--kind <k>] [--clear]
#   perf [--reload] [--duration <ms>]
#   solve_captcha [--verify]           report a challenge on the page (agent-native; never solves)
#                                      --verify re-checks after a solve: still present | clear
#
# Act on it (each prints what changed; --quiet leaves that out; --no-boundaries omits markers):
#   click <ref|label> | click --xy <x,y>
#   hover <ref|label> | hover --xy <x,y>         move the pointer, no button press
#   dialog accept [promptText] [targetId] | dialog dismiss [targetId]
#                                     answer an open alert/confirm/prompt. A trailing token that
#                                     looks like a targetId is the target, never prompt text; to
#                                     send text that looks like one, put the real targetId after it.
#   emulate [--viewport WxH[@scale]] [--mobile] [--color-scheme dark|light]
#           [--reduced-motion] [--offline] [--ua <str>] [--reset]
#   handoff <message> [--timeout <s>]            overlay for the user, wait, then continue
#   type [--fast] [--keys] <ref|label> <text> | type --focused [--fast] <text>
#   select [--fast] <ref|label> <option> native <select> or ARIA combobox
#   upload <ref|label> <path>         <input type="file"> (never opens OS picker)
#   drag <from> <to> [--side before|after]        HTML5 drag-and-drop or mouse drag
#   wait [--text <t>] [--selector <css>] [--url <u>] [--timeout <ms>]
#   key <Enter|Tab|Escape|Backspace|ArrowDown|ArrowUp|Space>
#   fill [--fast] '{"<ref|label>":"<text>",…}' | do '[…]'  batch fields or steps ('-' reads stdin)
#   script '<js>' [--timeout <ms>] [--out <path>] Playwright-like loop with persistent `state`
#   notes <get|set|append|rm|approve|list> [site] [text]
#   flow <record|save|run|list|show|rm> [name] [--site <s>] [--param k=v] [--where f=v] [--fields a,b] [--limit <n>]
#
# A <ref> is e12 (from snap), f2:e5 (inside iframe 2), a41 (from snap --ax), or a control's
# visible label in quotes. Every page command takes a targetId last or --match <text>.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
tmp="${TMPDIR:-/tmp}"
dir="${BROWSER_CONTROL_DAEMON_DIR:-${tmp%/}/browser-control-daemon}"
sock="$dir/sock"; log="$dir/daemon.log"; lock="$dir/starting"; build_file="$sock.build"
repo_url="https://github.com/TheSethRose/browser-control"
raw_manifest_url="https://raw.githubusercontent.com/TheSethRose/browser-control/main/capability.json"

fail() { printf '%s\n' '{"ok":false,"error":{"code":"'"$1"'","message":'"$(json_str "$2")"'}}'; exit 1; }


# Write the backend order atomically; report a JSON error if it can't be written.
write_backends() {
  local f="$dir/backends" t="$dir/backends.$$"
  if mkdir -p "$dir" && chmod 700 "$dir" && [[ ! -d "$f" ]] && printf '%s\n' "$1" >"$t" && mv -f "$t" "$f"; then return 0; fi
  rm -f "$t" 2>/dev/null || true
  fail EXECUTION_FAILED "could not write $f"
}
# Write the global natural-browsing setting atomically.
write_natural() {
  local d="${XDG_CONFIG_HOME:-$HOME/.config}/browser-control"
  local f="$d/natural" t="$d/natural.$$"
  if mkdir -p "$d" && chmod 700 "$d" && [[ ! -d "$f" ]] && printf '%s\n' "$1" >"$t" && mv -f "$t" "$f"; then return 0; fi
  rm -f "$t" 2>/dev/null || true
  fail EXECUTION_FAILED "could not write $f"
}
# Resolve natural browsing like src/natural.ts: env, then the config file, then on. Sets nat_val and nat_src.
natural_word() {
  local v="$1" r=""
  v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
  shopt -s nocasematch
  case "$v" in 0 | false | off | no) r=off ;; 1 | true | on | yes) r=on ;; esac
  shopt -u nocasematch
  printf '%s' "$r"
}
resolve_natural() {
  local f="${XDG_CONFIG_HOME:-$HOME/.config}/browser-control/natural" w
  nat_val=on; nat_src=default
  w="$(natural_word "${BROWSER_CONTROL_NATURAL:-}")"
  if [[ -n "$w" ]]; then nat_val="$w"; nat_src=env; return; fi
  [[ -f "$f" ]] && w="$(natural_word "$(cat "$f" 2>/dev/null)")"
  if [[ -n "$w" ]]; then nat_val="$w"; nat_src=file; fi
}

# True when `$1` has the shape of a targetId: extension:<n>, extension:<slug>:<n>, browse:<n>,
# optionally with @<frameId>, or a 32-hex DevTools id. Used where a trailing token could be either
# a target or literal text (dialog prompt text).
is_target_id() {
  local s="${1:-}"
  [[ "$s" =~ ^(extension:[A-Za-z0-9][A-Za-z0-9-]*:[0-9]+|extension:[0-9]+|browse:[0-9]+)(@[0-9]+)?$ ]] && return 0
  [[ "$s" =~ ^[0-9A-Fa-f]{32}$ ]]
}

# True when a one-line backend order value names the extension. Stays bash 3.2 clean.
order_has_extension() {
  local tok
  for tok in ${1//,/ }; do
    tok="$(printf '%s' "$tok" | tr '[:upper:]' '[:lower:]')"
    [[ "$tok" == extension ]] && return 0
  done
  return 1
}

cli_build() {
  local f="$here/../runtime/cli.js"
  [[ -f "$f" ]] || return 0
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$f" | cut -c1-12
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$f" | cut -c1-12
  fi
}

warn_if_stale() {
  local want running
  want="$(cli_build)"
  [[ -n "$want" && -S "$sock" ]] || return 0
  running="$(tr -d '[:space:]' <"$build_file" 2>/dev/null || true)"
  if [[ "$running" != "$want" ]]; then
    echo "browser-control-daemon: running daemon is an older build than runtime/cli.js. Ask the user to run: browser-control-daemon stop --force (remote debugging connections will need Allow again; the extension reconnects on its own)." >&2
  fi
}

local_version() {
  local f="$here/../runtime/capability.json"
  [[ -f "$f" ]] || f="$here/../../../../capability.json"
  [[ -f "$f" ]] || { echo "0.0.0"; return; }
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -n1
}

semver_gt() {
  local a1 a2 a3 b1 b2 b3
  IFS=. read -r a1 a2 a3 <<<"${1#v}"
  IFS=. read -r b1 b2 b3 <<<"${2#v}"
  a1=${a1:-0}; a2=${a2:-0}; a3=${a3:-0}; b1=${b1:-0}; b2=${b2:-0}; b3=${b3:-0}
  (( 10#$a1 > 10#$b1 )) && return 0
  (( 10#$a1 < 10#$b1 )) && return 1
  (( 10#$a2 > 10#$b2 )) && return 0
  (( 10#$a2 < 10#$b2 )) && return 1
  (( 10#$a3 > 10#$b3 ))
}

check_update() {
  local force="${1:-}" cur cache_dir cache latest="" raw_v="" rel_v=""
  cur="$(local_version)"
  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/browser-control"
  cache="$cache_dir/latest-version"
  if [[ "$force" != "--force" && -f "$cache" ]] && find "$cache" -maxdepth 0 -mmin -1440 2>/dev/null | grep -q .; then
    latest="$(tr -d '[:space:]' <"$cache" 2>/dev/null || true)"
  else
    raw_v="$(curl -fsSL --max-time 2 "$raw_manifest_url" 2>/dev/null | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1 || true)"
    rel_v="$(curl -fsSI --max-time 2 "$repo_url/releases/latest" 2>/dev/null | sed -n 's/^[Ll]ocation:.*\/tag\/v\?\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | tr -d '\r' | head -n1 || true)"
    latest="$raw_v"
    if [[ -n "$rel_v" ]] && { [[ -z "$latest" ]] || semver_gt "$rel_v" "$latest"; }; then
      latest="$rel_v"
    fi
    if [[ -n "$latest" ]]; then
      mkdir -p "$cache_dir" 2>/dev/null || true
      printf '%s\n' "$latest" >"$cache" 2>/dev/null || true
    fi
  fi
  if [[ -z "$latest" ]]; then
    echo "could not check for updates (local v$cur): $repo_url"
    return 0
  fi
  if semver_gt "$latest" "$cur"; then
    echo "update available: local v$cur -> latest v$latest ($repo_url). Alert the user; help them update only if they ask."
  else
    echo "up to date (v$cur): $repo_url"
  fi
}

# Agent session key: a short sha256 prefix, so raw session ids never leave this script.
session_key() {
  local id="${BROWSER_CONTROL_SESSION:-${CLAUDE_CODE_SESSION_ID:-${T3CODE_THREAD_ID:-${CODEX_THREAD_ID:-${CODEX_SESSION_ID:-}}}}}"
  [[ -n "$id" ]] || return 0
  if command -v shasum >/dev/null 2>&1; then printf '%s' "$id" | shasum -a 256 | cut -c1-16
  elif command -v sha256sum >/dev/null 2>&1; then printf '%s' "$id" | sha256sum | cut -c1-16
  fi
}

req() {
  local rc=0 mt=""
  # A long-running call (handoff) sets max_time so curl gives up just after the server would.
  [[ -z "${max_time:-}" ]] || mt="--max-time $max_time"
  resolve_natural
  [[ -n "${sess_key+x}" ]] || sess_key="$(session_key)"
  printf '%s' "${3:-}" | curl -sS --fail-with-body ${mt} -H "x-bc-natural: $nat_val" -H "x-bc-session: $sess_key" --unix-socket "$sock" -X "$1" \
    --data-binary @- "http://daemon/$2" 2>/dev/null || rc=$?
  case $rc in 0) ;; 22) return 1 ;; 7) return 7 ;; *) return 9 ;; esac
}
up() { req GET status >/dev/null; }

ensure() {
  up && return 0
  command -v bun >/dev/null 2>&1 || { echo "browser-control-daemon: bun is required (https://bun.sh)" >&2; exit 127; }
  mkdir -p "$dir"; chmod 700 "$dir"
  find "$lock" -maxdepth 0 -mmin +1 -exec rmdir {} \; 2>/dev/null || true
  if mkdir "$lock" 2>/dev/null; then
    up || { rm -f "$sock" "$build_file"; nohup bun "$here/../runtime/cli.js" --serve "$sock" >"$log" 2>&1 & }
  fi
  for _ in $(seq 100); do up && break; sleep 0.05; done
  rmdir "$lock" 2>/dev/null || true
  up || fail DAEMON_START_FAILED "daemon did not start; see $log. Tell the user; do not work around it."
}

run() {
  local rc=0 out started=0
  out="$(req "$@")" || rc=$?
  if [[ $rc -eq 7 ]]; then ensure; started=1; rc=0; out="$(req "$@")" || rc=$?; fi
  [[ $started -eq 1 ]] || warn_if_stale
  [[ -z "$out" ]] || printf '%s\n' "$out"
  case $rc in
    0) return 0 ;;
    9) fail CONNECTION_LOST "the daemon dropped the connection mid-call; the action may have been delivered. Check the page before retrying." ;;
  esac
  if [[ "$out" == *"unknown page helper"* || "$out" == *"unknown daemon route"* ]]; then
    echo "browser-control-daemon: the running daemon is an older build than this script. Ask the user to run: browser-control-daemon stop --force (remote debugging connections will need Allow again; the extension reconnects on its own)." >&2
  fi
  exit 1
}

json_str() {
  local s=$1
  if [[ "$s" == *[$'\001'-$'\010'$'\013'$'\014'$'\016'-$'\037']* ]]; then
    printf '%s' "$s" | bun -e 'process.stdout.write(JSON.stringify(require("fs").readFileSync(0, "utf8")))'
    return
  fi
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}
  printf '"%s"' "$s"
}
urlencode() {
  local LC_ALL=C s=$1 out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in [a-zA-Z0-9.~_-]) out+=$c ;; *) out+=$(printf '%%%02X' "'$c") ;; esac
  done
  printf '%s' "$out"
}
body() { if [[ "$1" == "-" ]]; then cat; else printf '%s' "$1"; fi; }
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }

cmd="${1:-}"; [[ $# -gt 0 ]] && shift

# Flags may sit anywhere after the command; unknown --flags are rejected immediately.
match=""; quiet=""; raw=""; all=false; ax=false; keys=false; fast=false; focused=false; marks=false; full=false; png=false; snap=""
verify=false
scroll=false; reload=false; clear_flag=false
find=""; within=""; max=""; until=""; xy=""; ref_flag=""; to=""; out_path=""
wait_text=""; wait_selector=""; wait_url=""; timeout=""
filter=""; limit=""; fields=""; concurrency=""; side=""; duration=""; kind=""; properties=""; site=""
browser=""; viewport=""; color_scheme=""; ua=""; mobile=false; reduced_motion=false; offline=false; reset_flag=false
max_time=""; new_window=""; keep_open=""; new_tab=""
params_list=(); where_list=()
args=()
case "$cmd" in snap | text | form | query | read-urls | ocr | click | hover | type | select | upload | drag | wait | key | value | shot | nav | eval | close | fill | do | verdict | health | styles | issues | perf | dialog | emulate | handoff | solve_captcha | notes | flow | script)
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --match) match="${2:?--match needs text from the tab url or title}"; shift 2 ;;
      --quiet) quiet=1; shift ;;
      --no-boundaries) raw=1; shift ;;
      --all) all=true; shift ;;
      --ax) ax=true; shift ;;
      --keys) keys=true; shift ;;
      --fast) fast=true; shift ;;
      --focused) focused=true; shift ;;
      --marks) marks=true; shift ;;
      --full) full=true; shift ;;
      --png) png=true; shift ;;
      --snap) snap=1; shift ;;
      --scroll) scroll=true; shift ;;
      --reload) reload=true; shift ;;
      --clear) clear_flag=true; shift ;;
      --verify) verify=true; shift ;;
      --find) find="${2:?--find needs text}"; shift 2 ;;
      --within) within="${2:?--within needs a ref or CSS selector}"; shift 2 ;;
      --max) max="${2:?--max needs a number}"; shift 2 ;;
      --until) until="${2:?--until needs load or dom}"; shift 2 ;;
      --xy) xy="${2:?--xy needs x,y}"; shift 2 ;;
      --ref) ref_flag="${2:?--ref needs a ref}"; shift 2 ;;
      --to) to="${2:?--to needs a file path}"; shift 2 ;;
      --out) out_path="${2:?--out needs a file path}"; shift 2 ;;
      --text) wait_text="${2:?--text needs text to wait for}"; shift 2 ;;
      --selector) wait_selector="${2:?--selector needs a CSS selector}"; shift 2 ;;
      --url) wait_url="${2:?--url needs a URL substring}"; shift 2 ;;
      --timeout) timeout="${2:?--timeout needs milliseconds}"; shift 2 ;;
      --filter) filter="${2:?--filter needs text}"; shift 2 ;;
      --limit) limit="${2:?--limit needs a number}"; shift 2 ;;
      --fields) fields="${2:?--fields needs k=sel,... or a,b}"; shift 2 ;;
      --concurrency) concurrency="${2:?--concurrency needs a number}"; shift 2 ;;
      --side) side="${2:?--side needs before or after}"; shift 2 ;;
      --duration) duration="${2:?--duration needs milliseconds}"; shift 2 ;;
      --kind) kind="${2:?--kind needs an issue kind}"; shift 2 ;;
      --properties) properties="${2:?--properties needs comma-separated CSS properties}"; shift 2 ;;
      --site) site="${2:?--site needs a site host}"; shift 2 ;;
      --browser) browser="${2:?--browser needs a browser name such as chrome or brave}"; shift 2 ;;
      --viewport) viewport="${2:?--viewport needs WxH or WxH@scale}"; shift 2 ;;
      --color-scheme) color_scheme="${2:?--color-scheme needs dark or light}"; shift 2 ;;
      --ua) ua="${2:?--ua needs a user-agent string}"; shift 2 ;;
      --mobile) mobile=true; shift ;;
      --reduced-motion) reduced_motion=true; shift ;;
      --offline) offline=true; shift ;;
      --reset) reset_flag=true; shift ;;
      --new-window | --keep-open | --new-tab)
        [[ "$cmd" == nav ]] || fail INPUT_INVALID "unknown flag: $1 ($1 works only with nav)"
        case "$1" in --new-window) new_window=1 ;; --new-tab) new_tab=1 ;; *) keep_open=1 ;; esac
        shift ;;
      --param) params_list+=("${2:?--param needs key=value}"); shift 2 ;;
      --where) where_list+=("${2:?--where needs field=value}"); shift 2 ;;
      --) shift; while [[ $# -gt 0 ]]; do args+=("$1"); shift; done ;;
      --*) fail INPUT_INVALID "unknown flag: $1 (pass -- before a positional argument starting with --)" ;;
      *) args+=("$1"); shift ;;
    esac
  done ;;
*) args=("$@") ;;
esac
arg() { printf '%s' "${args[$1]:-}"; }

query() {
  local q=""
  [[ -z "${1:-}" ]] || q+="&t=$(urlencode "$1")"
  [[ -z "$match" ]] || q+="&m=$(urlencode "$match")"
  [[ -z "$browser" ]] || q+="&browser=$(urlencode "$browser")"
  [[ -z "$quiet" ]] || q+="&q=1"
  [[ -z "$raw" ]] || q+="&raw=1"
  [[ -z "${2:-}" ]] || q+="&$2"
  [[ -z "$q" ]] || printf '?%s' "${q#&}"
}

abs_path() { local p="$1"; [[ "$p" == /* ]] && printf '%s' "$p" || printf '%s' "$PWD/$p"; }

kv_json_obj() {
  local out="{" sep="" item k v
  for item in "$@"; do
    k="${item%%=*}"; v="${item#*=}"
    out+="${sep}$(json_str "$k"):$(json_str "$v")"; sep=","
  done
  printf '%s}' "$out"
}

csv_json_arr() {
  local out="[" sep="" part
  local IFS=,
  for part in $1; do
    out+="${sep}$(json_str "$part")"; sep=","
  done
  printf '%s]' "$out"
}

case "$cmd" in
  start)
    case "$(arg 0)" in
      "") input='{"timeoutMs":60000}' ;;
      *[!0-9]*) b="$(arg 0)"; input='{"browser":"'"${b//[\"\\]/}"'","timeoutMs":60000}' ;;
      *) input='{"port":'"$(arg 0)"',"timeoutMs":60000}' ;;
    esac
    run POST call/connect_browser "$input"
    ;;
  eval)
    [[ ${#args[@]} -ge 1 ]] || fail INPUT_INVALID "usage: browser-control-daemon eval '<js>' [targetId]"
    run POST "eval$(query "$(arg 1)")" "$(body "$(arg 0)")"
    ;;
  nav)
    [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon nav <url> [targetId] [--snap] [--until load] [--new-window] [--new-tab] [--keep-open] [--fast]"
    extra=""; [[ -z "$snap" ]] || extra="snap=1"
    [[ "$until" != "load" ]] || extra="${extra:+$extra&}until=load"
    [[ -z "$new_window" ]] || extra="${extra:+$extra&}new_window=1"
    [[ -z "$keep_open" ]] || extra="${extra:+$extra&}keep_open=1"
    [[ -z "$new_tab" ]] || extra="${extra:+$extra&}new_tab=1"
    [[ "$fast" != true ]] || extra="${extra:+$extra&}fast=1"
    run POST "nav$(query "$(arg 1)" "$extra")" "$(arg 0)"
    ;;
  tabs | ops) run GET "$cmd" ;;
  close)
    run POST "close$(query "$(arg 0)")" ''
    ;;
  snap)
    input='{"all":'"$all"',"ax":'"$ax"',"full":'"$full"
    [[ -z "$find" ]] || input+=',"find":'"$(json_str "$find")"
    [[ -z "$within" ]] || input+=',"within":'"$(json_str "$within")"
    [[ -z "$out_path" ]] || input+=',"out":'"$(json_str "$(abs_path "$out_path")")"
    run POST "page/snap$(query "$(arg 0)")" "$input}"
    ;;
  text)
    input='{"all":'"$all"',"scroll":'"$scroll"
    [[ -z "$within" ]] || input+=',"within":'"$(json_str "$within")"
    [[ -z "$max" ]] || input+=',"max":'"$((max))"
    [[ -z "$filter" ]] || input+=',"filter":'"$(json_str "$filter")"
    [[ -z "$limit" ]] || input+=',"limit":'"$((limit))"
    [[ -z "$timeout" ]] || input+=',"timeoutMs":'"$((timeout))"
    [[ -z "$out_path" ]] || input+=',"out":'"$(json_str "$(abs_path "$out_path")")"
    [[ "$fast" != true ]] || input+=',"fast":true'
    run POST "page/text$(query "$(arg 0)")" "$input}"
    ;;
  form)
    input='{' ; sep=''
    if [[ -n "$within" ]]; then input+="${sep}\"within\":$(json_str "$within")"; sep=','; fi
    if [[ -n "$out_path" ]]; then input+="${sep}\"out\":$(json_str "$(abs_path "$out_path")")"; fi
    run POST "page/form$(query "$(arg 0)")" "$input}"
    ;;
  query)
    [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon query <css> [--fields k=sel,...] [--limit N] [targetId]"
    input='{"selector":'"$(json_str "$(arg 0)")"',"all":'"$all"
    [[ -z "$limit" ]] || input+=',"limit":'"$((limit))"
    if [[ -n "$fields" ]]; then
      IFS=, read -ra fpairs <<<"$fields"
      input+=',"fields":'"$(kv_json_obj "${fpairs[@]}")"
    fi
    [[ -z "$out_path" ]] || input+=',"out":'"$(json_str "$(abs_path "$out_path")")"
    run POST "page/query$(query "$(arg 1)")" "$input}"
    ;;
  read-urls)
    [[ ${#args[@]} -ge 1 ]] || fail INPUT_INVALID "usage: browser-control-daemon read-urls <url1> [url2 ...] [--concurrency N]"
    uarr="[" ; sep=""
    for u in "${args[@]}"; do uarr+="${sep}$(json_str "$u")"; sep=","; done
    uarr+="]"
    input='{"urls":'"$uarr"
    [[ -z "$concurrency" ]] || input+=',"concurrency":'"$((concurrency))"
    [[ -z "$timeout" ]] || input+=',"timeoutMs":'"$((timeout))"
    [[ -z "$max" ]] || input+=',"maxChars":'"$((max))"
    [[ -z "$out_path" ]] || input+=',"out":'"$(json_str "$(abs_path "$out_path")")"
    run POST "page/read-urls$(query "")" "$input}"
    ;;
  click)
    if [[ -n "$xy" ]]; then
      [[ "$xy" =~ ^[0-9.]+,[0-9.]+$ ]] || fail INPUT_INVALID "--xy takes x,y in CSS pixels, e.g. --xy 120,240"
      input='{"xy":['"$xy"']'
      [[ "$fast" != true ]] || input+=',"fast":true'
      run POST "page/click$(query "$(arg 0)")" "$input}"
    else
      [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon click <ref|label> [targetId]"
      input='{"ref":'"$(json_str "$(arg 0)")"
      [[ "$fast" != true ]] || input+=',"fast":true'
      run POST "page/click$(query "$(arg 1)")" "$input}"
    fi
    ;;
  hover)
    if [[ -n "$xy" ]]; then
      [[ "$xy" =~ ^(0|[1-9][0-9]*)(\.[0-9]+)?,(0|[1-9][0-9]*)(\.[0-9]+)?$ ]] || fail INPUT_INVALID "--xy takes x,y in CSS pixels, e.g. --xy 120,240"
      input='{"xy":['"$xy"']'
      [[ "$fast" != true ]] || input+=',"fast":true'
      run POST "page/hover$(query "$(arg 0)")" "$input}"
    else
      [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon hover <ref|label> [targetId] | hover --xy x,y [targetId]"
      input='{"ref":'"$(json_str "$(arg 0)")"
      [[ "$fast" != true ]] || input+=',"fast":true'
      run POST "page/hover$(query "$(arg 1)")" "$input}"
    fi
    ;;
  dialog)
    sub="$(arg 0)"
    case "$sub" in
      accept | dismiss) ;;
      *) fail INPUT_INVALID "usage: browser-control-daemon dialog accept [promptText] [targetId] | dialog dismiss [targetId]" ;;
    esac
    input='{"sub":'"$(json_str "$sub")"
    if [[ "$sub" == dismiss ]]; then
      run POST "page/dialog$(query "$(arg 1)")" "$input}"
    else
      text=""; target=""
      if [[ ${#args[@]} -ge 3 ]]; then
        text="${args[1]}"; target="${args[2]}"
      elif [[ ${#args[@]} -eq 2 ]]; then
        # A trailing token that is a targetId is always the target, never prompt text.
        if is_target_id "${args[1]}"; then target="${args[1]}"; else text="${args[1]}"; fi
      fi
      [[ -z "$text" ]] || input+=',"text":'"$(json_str "$text")"
      run POST "page/dialog$(query "$target")" "$input}"
    fi
    ;;
  emulate)
    [[ -z "$color_scheme" || "$color_scheme" == dark || "$color_scheme" == light ]] || fail INPUT_INVALID "--color-scheme takes dark or light"
    input='{'; sep=''
    if [[ -n "$viewport" ]]; then
      [[ "$viewport" =~ ^[0-9]+x[0-9]+(@[0-9]+(\.[0-9]+)?)?$ ]] || fail INPUT_INVALID "--viewport takes WxH or WxH@scale, e.g. 390x844 or 390x844@3"
      input+="${sep}\"viewport\":$(json_str "$viewport")"; sep=','
    fi
    if [[ -n "$color_scheme" ]]; then input+="${sep}\"colorScheme\":$(json_str "$color_scheme")"; sep=','; fi
    if [[ -n "$ua" ]]; then input+="${sep}\"ua\":$(json_str "$ua")"; sep=','; fi
    if [[ "$mobile" == true ]]; then input+="${sep}\"mobile\":true"; sep=','; fi
    if [[ "$reduced_motion" == true ]]; then input+="${sep}\"reducedMotion\":true"; sep=','; fi
    if [[ "$offline" == true ]]; then input+="${sep}\"offline\":true"; sep=','; fi
    if [[ "$reset_flag" == true ]]; then input+="${sep}\"reset\":true"; sep=','; fi
    [[ -n "$sep" ]] || fail INPUT_INVALID "usage: browser-control-daemon emulate [--viewport WxH[@scale]] [--mobile] [--color-scheme dark|light] [--reduced-motion] [--offline] [--ua <str>] [--reset] [targetId]"
    run POST "page/emulate$(query "$(arg 0)")" "$input}"
    ;;
  handoff)
    secs=600
    if [[ -n "$timeout" ]]; then
      [[ "$timeout" =~ ^[0-9]+$ ]] && (( 10#$timeout > 0 )) || fail INPUT_INVALID "--timeout takes whole seconds above 0, e.g. --timeout 120"
      secs=$((10#$timeout))
    fi
    # The call blocks until the user finishes or the server times out, so curl must wait longer.
    max_time=$((secs + 30))
    input='{'; sep=''
    if [[ -n "$(arg 0)" ]]; then input+="${sep}\"message\":$(json_str "$(body "$(arg 0)")")"; sep=','; fi
    if [[ -n "$timeout" ]]; then input+="${sep}\"timeout\":$secs"; sep=','; fi
    run POST "page/handoff$(query "$(arg 1)")" "$input}"
    ;;
  ocr)
    input='{'; [[ -z "$find" ]] || input+='"find":'"$(json_str "$find")"
    run POST "page/ocr$(query "$(arg 0)")" "$input}"
    ;;
  solve_captcha)
    input='{}'
    [[ "$verify" != true ]] || input='{"verify":true}'
    run POST "page/solve_captcha$(query "$(arg 0)")" "$input"
    ;;
  type)
    if [[ "$focused" == true ]]; then
      [[ ${#args[@]} -ge 1 ]] || fail INPUT_INVALID "usage: browser-control-daemon type --focused [--fast] [--keys] <text> [targetId]"
      run POST "page/type$(query "$(arg 1)")" '{"focused":true,"text":'"$(json_str "$(arg 0)")"',"fast":'"$fast"',"keys":'"$keys"'}'
      exit 0
    fi
    [[ ${#args[@]} -ge 2 ]] || fail INPUT_INVALID "usage: browser-control-daemon type [--fast] [--keys] <ref|label> <text> [targetId]"
    run POST "page/type$(query "$(arg 2)")" '{"ref":'"$(json_str "$(arg 0)")"',"text":'"$(json_str "$(arg 1)")"',"fast":'"$fast"',"keys":'"$keys"'}'
    ;;
  select)
    [[ ${#args[@]} -ge 2 ]] || fail INPUT_INVALID "usage: browser-control-daemon select [--fast] <ref|label> <option> [targetId]"
    input='{"ref":'"$(json_str "$(arg 0)")"',"option":'"$(json_str "$(arg 1)")"
    [[ "$fast" != true ]] || input+=',"fast":true'
    run POST "page/select$(query "$(arg 2)")" "$input}"
    ;;
  upload)
    [[ ${#args[@]} -ge 2 ]] || fail INPUT_INVALID "usage: browser-control-daemon upload <ref|label> <path> [targetId]"
    fpath="$(abs_path "$(arg 1)")"
    run POST "page/upload$(query "$(arg 2)")" '{"ref":'"$(json_str "$(arg 0)")"',"path":'"$(json_str "$fpath")"'}'
    ;;
  drag)
    [[ ${#args[@]} -ge 2 ]] || fail INPUT_INVALID "usage: browser-control-daemon drag <from> <to> [--side before|after] [--fast] [targetId]"
    input='{"from":'"$(json_str "$(arg 0)")"',"to":'"$(json_str "$(arg 1)")"
    [[ -z "$side" ]] || input+=',"side":'"$(json_str "$side")"
    [[ "$fast" != true ]] || input+=',"fast":true'
    run POST "page/drag$(query "$(arg 2)")" "$input}"
    ;;
  wait)
    [[ -n "$wait_text" || -n "$wait_selector" || -n "$wait_url" ]] || fail INPUT_INVALID "usage: browser-control-daemon wait [--text <t>] [--selector <css>] [--url <u>] [--timeout <ms>] [targetId]"
    input='{' ; sep=''
    if [[ -n "$wait_text" ]]; then input+="${sep}\"text\":$(json_str "$wait_text")"; sep=','; fi
    if [[ -n "$wait_selector" ]]; then input+="${sep}\"selector\":$(json_str "$wait_selector")"; sep=','; fi
    if [[ -n "$wait_url" ]]; then input+="${sep}\"url\":$(json_str "$wait_url")"; sep=','; fi
    if [[ -n "$timeout" ]]; then
      [[ "$timeout" =~ ^[0-9]+$ ]] || fail INPUT_INVALID "--timeout must be a positive integer in milliseconds"
      input+="${sep}\"timeoutMs\":$timeout"
    fi
    run POST "page/wait$(query "$(arg 0)")" "$input}"
    ;;
  key)
    [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon key [--fast] <name> [targetId]"
    input='{"key":'"$(json_str "$(arg 0)")"
    [[ "$fast" != true ]] || input+=',"fast":true'
    run POST "page/key$(query "$(arg 1)")" "$input}"
    ;;
  value)
    [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon value <ref|label> [targetId]"
    run POST "page/value$(query "$(arg 1)")" '{"ref":'"$(json_str "$(arg 0)")"'}'
    ;;
  fill)
    [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon fill [--fast] '{\\\"<ref|label>\\\":\\\"<text>\\\"}' [targetId]"
    run POST "page/do$(query "$(arg 1)")" '{"fill":'"$(body "$(arg 0)")"',"fast":'"$fast"'}'
    ;;
  do)
    [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon do [--fast] '<json array of steps>' [targetId]"
    input='{"steps":'"$(body "$(arg 0)")"
    [[ "$fast" != true ]] || input+=',"fast":true'
    run POST "page/do$(query "$(arg 1)")" "$input}"
    ;;
  shot)
    input='{"marks":'"$marks"',"full":'"$full"',"png":'"$png"
    [[ -z "$ref_flag" ]] || input+=',"ref":'"$(json_str "$ref_flag")"
    [[ -z "$to" ]] || input+=',"path":'"$(json_str "$(abs_path "$to")")"
    run POST "page/shot$(query "$(arg 0)")" "$input}"
    ;;
  styles)
    [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon styles <ref|css> [--properties a,b] [targetId]"
    input='{"ref":'"$(json_str "$(arg 0)")"
    [[ -z "$properties" ]] || input+=',"properties":'"$(csv_json_arr "$properties")"
    run POST "page/styles$(query "$(arg 1)")" "$input}"
    ;;
  issues)
    input='{"clear":'"$clear_flag"
    [[ -z "$kind" ]] || input+=',"kind":'"$(json_str "$kind")"
    run POST "page/issues$(query "$(arg 0)")" "$input}"
    ;;
  perf)
    input='{"reload":'"$reload"
    [[ -z "$duration" ]] || input+=',"durationMs":'"$((duration))"
    run POST "page/perf$(query "$(arg 0)")" "$input}"
    ;;
  notes)
    sub="$(arg 0)"; [[ -n "$sub" ]] || sub="get"
    input='{"sub":'"$(json_str "$sub")"
    if [[ "$sub" == "set" || "$sub" == "append" ]]; then
      if [[ ${#args[@]} -ge 3 ]]; then
        input+=',"site":'"$(json_str "$(arg 1)")"',"text":'"$(json_str "$(body "$(arg 2)")")"
      else
        input+=',"text":'"$(json_str "$(body "$(arg 1)")")"
      fi
    elif [[ -n "$(arg 1)" ]]; then
      input+=',"site":'"$(json_str "$(arg 1)")"
    fi
    [[ -z "$site" ]] || input+=',"site":'"$(json_str "$site")"
    run POST "page/notes$(query "")" "$input}"
    ;;
  flow)
    sub="$(arg 0)"; [[ -n "$sub" ]] || sub="list"
    input='{"sub":'"$(json_str "$sub")"
    [[ -z "$(arg 1)" ]] || input+=',"name":'"$(json_str "$(arg 1)")"
    [[ -z "$site" ]] || input+=',"site":'"$(json_str "$site")"
    [[ -z "$limit" ]] || input+=',"limit":'"$((limit))"
    [[ -z "$fields" ]] || input+=',"fields":'"$(csv_json_arr "$fields")"
    if [[ ${#params_list[@]} -gt 0 ]]; then input+=',"params":'"$(kv_json_obj "${params_list[@]}")"; fi
    if [[ ${#where_list[@]} -gt 0 ]]; then input+=',"where":'"$(kv_json_obj "${where_list[@]}")"; fi
    run POST "page/flow$(query "")" "$input}"
    ;;
  script)
    [[ ${#args[@]} -ge 1 ]] || fail INPUT_INVALID "usage: browser-control-daemon script [--fast] '<js>' [--timeout <ms>] [--out <path>] [targetId]"
    code="$(body "$(arg 0)")"
    input='{"code":'"$(json_str "$code")"
    [[ -z "$timeout" ]] || input+=',"timeoutMs":'"$((timeout))"
    [[ -z "$out_path" ]] || input+=',"out":'"$(json_str "$(abs_path "$out_path")")"
    [[ "$fast" != true ]] || input+=',"fast":true'
    run POST "page/script$(query "$(arg 1)")" "$input}"
    ;;
  verdict | health) run POST "page/$cmd$(query "$(arg 0)")" '{}' ;;
  call)
    [[ -n "$(arg 0)" ]] || fail INPUT_INVALID "usage: browser-control-daemon call <operation> ['<json>']"
    run POST "call/$(arg 0)" "$(arg 1)"
    ;;
  default)
    file="${XDG_CONFIG_HOME:-$HOME/.config}/browser-control/default-browser"
    if [[ -n "$(arg 0)" ]]; then mkdir -p "$(dirname "$file")"; printf '%s\n' "$(arg 0)" >"$file"; fi
    cat "$file" 2>/dev/null || echo "(none: the first browser with remote debugging on is used)"
    ;;
  natural)
    sub="$(arg 0)"
    file="${XDG_CONFIG_HOME:-$HOME/.config}/browser-control/natural"
    case "$sub" in
      on | off)
        write_natural "$sub"
        printf '%s\n' '{"ok":true,"data":{"natural":'"$(json_str "$sub")"',"file":'"$(json_str "$file")"'}}'
        ;;
      "" | status)
        resolve_natural
        printf '%s\n' '{"ok":true,"data":{"natural":'"$(json_str "$nat_val")"',"source":'"$(json_str "$nat_src")"',"file":'"$(json_str "$file")"'}}'
        ;;
      *) fail INPUT_INVALID "usage: browser-control-daemon natural [on|off|status]" ;;
    esac
    ;;
  check-update)
    check_update "$(arg 0)"
    ;;
  status)
    if out="$(req GET status)"; then
      warn_if_stale
      printf '%s\n' "$out"
    else
      printf '%s\n' '{"ok":true,"data":{"running":false}}'
    fi
    ;;
  stop)
    [[ "$(arg 0)" == "--force" ]] || fail STOP_REFUSED "stopping drops every browser connection; remote debugging (cdp) makes the user click Allow again. Nothing is fixed by restarting. Only if the user asked: stop --force"
    req POST stop >/dev/null || true; rm -f "$build_file" 2>/dev/null || true; echo '{"ok":true,"data":{"running":false}}'
    ;;
  extension)
    sub="$(arg 0)"
    case "$sub" in
      setup)
        ext_dir="$(arg 1)"
        if [[ -z "$ext_dir" ]]; then
          ext_dir="$(cd "$here/../../../.." 2>/dev/null && pwd)/extension"
          [[ -f "$ext_dir/manifest.json" ]] || fail INPUT_INVALID "no extension/ folder next to this skill; run: browser-control-daemon extension setup <extensionDir>"
        fi
        [[ -f "$ext_dir/manifest.json" ]] || fail INPUT_INVALID "not an extension folder (no manifest.json): $ext_dir"
        ext_dir="$(cd "$ext_dir" && pwd)"
        command -v bun >/dev/null 2>&1 || { echo "browser-control-daemon: bun is required (https://bun.sh)" >&2; exit 127; }
        bun "$here/../runtime/cli.js" extension-setup "$ext_dir" >/dev/null || fail EXECUTION_FAILED "pairing setup failed; see the error above"
        rm -f "$dir/backends" 2>/dev/null || fail EXECUTION_FAILED "could not remove $dir/backends"
        # A leftover global order file (~/.config/browser-control/backends) outranks the paired
        # default; if it leaves the extension out, back it up and rewrite it to extension alone.
        extra=""
        gpath="${XDG_CONFIG_HOME:-$HOME/.config}/browser-control/backends"
        if [[ -f "$gpath" ]]; then
          # Parse exactly like the router (backendOrder): whole file, split on /[\s,]+/, lowercased.
          # Prints the normalized order on line 1 and 1/0 (has extension) on line 2.
          gparsed="$(bun -e 'const n=require("fs").readFileSync(process.argv[1],"utf8").split(/[\s,]+/).map((x)=>x.trim().toLowerCase()).filter(Boolean);process.stdout.write(n.join(",")+"\n"+(n.includes("extension")?1:0))' "$gpath" 2>/dev/null || true)"
          gorder="${gparsed%%$'\n'*}" ghas="${gparsed##*$'\n'}"
          if [[ -n "$gorder" && "$ghas" == 0 ]]; then
            # Create the backup exclusively (noclobber), taking the next -N suffix if one exists.
            gbase="$gpath.bak-$(date +%Y-%m-%d)" gbackup="" n=1
            while [[ $n -lt 100 ]]; do
              cand="$gbase"; [[ $n -gt 1 ]] && cand="$gbase-$n"
              if (set -C; cat "$gpath" >"$cand") 2>/dev/null; then gbackup="$cand"; break; fi
              [[ -e "$cand" ]] || fail EXECUTION_FAILED "could not back up $gpath to $cand"
              n=$((n + 1))
            done
            [[ -n "$gbackup" ]] || fail EXECUTION_FAILED "could not back up $gpath"
            # Write a same-directory temp copy (keeps the file mode), then rename it into place.
            gtmp="$gpath.tmp.$$"
            # GNU stat first (BSD stat rejects -c); accept only a plain octal mode.
            gmode="$(stat -c %a "$gpath" 2>/dev/null || true)"
            [[ "$gmode" =~ ^[0-7]{3,4}$ ]] || gmode="$(stat -f %Lp "$gpath" 2>/dev/null || true)"
            [[ "$gmode" =~ ^[0-7]{3,4}$ ]] || gmode=600
            if ! { cp -p "$gpath" "$gtmp" && chmod "$gmode" "$gbackup" && printf 'extension\n' >"$gtmp" && mv -f "$gtmp" "$gpath"; }; then
              rm -f "$gtmp" 2>/dev/null || true
              fail EXECUTION_FAILED "could not write $gpath"
            fi
            extra=',"globalOrder":{"was":'"$(json_str "$gorder")"',"now":"extension","backup":'"$(json_str "$gbackup")"'}'
          fi
        fi
        if [[ -n "${BROWSER_CONTROL_BACKENDS:-}" ]] && ! order_has_extension "$BROWSER_CONTROL_BACKENDS"; then
          extra+=',"overriddenBy":'"$(json_str "env BROWSER_CONTROL_BACKENDS=$BROWSER_CONTROL_BACKENDS")"
        fi
        printf '%s\n' '{"ok":true,"data":{"paired":true,"orderFile":"removed","extensionDir":'"$(json_str "$ext_dir")$extra"',"next":"In Chrome open chrome://extensions, turn on Developer mode, click Load unpacked, and pick extensionDir. Then run: browser-control-daemon extension browsers"}}'
        ;;
      status | browsers | diagnostics) run GET "extension/$sub" ;;
      enable)
        rm -f "$dir/backends" 2>/dev/null || fail EXECUTION_FAILED "could not remove $dir/backends"
        printf '%s\n' '{"ok":true,"data":{"orderFile":"removed"}}'
        ;;
      disable)
        write_backends "cdp"
        printf '%s\n' '{"ok":true,"data":{"backends":"cdp"}}'
        ;;
      pair | revoke) fail INPUT_INVALID "extension $sub is not available yet: it ships with the Web Store build. Use: browser-control-daemon extension setup" ;;
      *) fail INPUT_INVALID "usage: browser-control-daemon extension setup [extensionDir] | status | browsers | diagnostics | enable | disable" ;;
    esac
    ;;
  help | -h | --help) usage ;;
  *) usage; exit 2 ;;
esac
